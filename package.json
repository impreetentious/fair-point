{
  "name": "fairpoint",
  "private": true,
  "version": "0.14.1",
  "type": "module",
  "engines": {
    "node": "20.19.x"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "npm run typecheck && next build && node scripts/generate-sw.mjs",
    "preview": "serve -l 4173 out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "fixtures": "vitest run tests/fixtures.test.ts --passWithNoTests",
    "bench": "vitest run tests/bench.test.ts tests/pipeline-bench.test.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "test:a11y": "node scripts/lighthouse-a11y.mjs",
    "gates": "npm run test:e2e && npm run test:a11y",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run fixtures"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "2.15.1",
    "zod": "3.24.2",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.17.24",
    "@types/react": "19.1.14",
    "@types/react-dom": "19.1.9",
    "@typescript-eslint/eslint-plugin": "8.27.0",
    "@typescript-eslint/parser": "8.27.0",
    "eslint": "8.57.1",
    "fast-check": "4.0.0",
    "js-yaml": "4.1.0",
    "lighthouse": "12.8.2",
    "prettier": "3.6.2",
    "serve": "14.2.5",
    "typescript": "5.7.3",
    "vitest": "3.0.9"
  },
  "license": "MIT",
  "author": "Sidakpreet Singh",
  "description": "Client-side term-sheet bargaining studio with exact waterfall and Pareto frontiers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/fair-point.git"
  },
  "bugs": {
    "url": "https://github.com/ItsMonarch04/fair-point/issues"
  },
  "homepage": "https://github.com/ItsMonarch04/fair-point#"
}
