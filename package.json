{
  "name": "fairpoint",
  "private": true,
  "version": "0.18.1",
  "type": "module",
  "engines": {
    "node": "22.22.x"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4174",
    "build": "npm run typecheck && next build && node scripts/generate-sw.mjs",
    "preview": "serve -l tcp://127.0.0.1:4173 --no-port-switching --config ../serve.json out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "fixtures": "vitest run tests/fixtures.test.ts",
    "bench": "vitest run tests/bench.test.ts tests/pipeline-bench.test.ts",
    "test:e2e": "playwright test",
    "test:a11y": "node scripts/lighthouse-a11y.mjs",
    "budget:bundle": "node scripts/bundle-budget.mjs",
    "gates": "npm run budget:bundle && npm run check:csp && npm run test:e2e && npm run test:a11y",
    "verify": "npm run check:version && npm run typecheck && npm run check:citations && npm run check:docs && npm run lint && npm run format:check && npm run test && npm run fixtures",
    "check:version": "node scripts/check-version-coherence.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:csp": "node scripts/check-csp.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.10.1",
    "zod": "3.24.2",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "chrome-launcher": "1.2.1",
    "eslint": "10.8.0",
    "fast-check": "4.0.0",
    "globals": "17.8.0",
    "js-yaml": "4.3.2",
    "lighthouse": "13.4.1",
    "prettier": "3.9.5",
    "serve": "14.2.6",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.4",
    "next": {
      "sharp": "0.35.4"
    },
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
    "nanoid@<3.3.18": "3.3.18"
  },
  "license": "Apache-2.0",
  "author": "Sidakpreet Singh",
  "description": "Client-side term-sheet bargaining studio with deterministic waterfall and Pareto frontiers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impreetentious/fair-point.git"
  },
  "bugs": {
    "url": "https://github.com/impreetentious/fair-point/issues"
  },
  "homepage": "https://github.com/impreetentious/fair-point"
}
