{
  "name": "fairpoint",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": "20.18.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run --passWithNoTests",
    "fixtures": "vitest run tests/fixtures.test.ts --passWithNoTests",
    "bench": "vitest run tests/bench.test.ts tests/pipeline-bench.test.ts --passWithNoTests",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run fixtures"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.0",
    "zod": "3.24.1",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.17.14",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.21.0",
    "@typescript-eslint/parser": "8.21.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "8.57.1",
    "fast-check": "3.23.2",
    "js-yaml": "4.1.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "3.0.3"
  }
}
